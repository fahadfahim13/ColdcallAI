# ColdCallAI — Environment Variables
# Copy to .env and fill in values before running anything.
# NEVER commit .env to git.

# === LLM ===
QWEN_VLLM_ENDPOINT=http://your-server:8000/v1
QWEN_MODEL_NAME=Qwen/Qwen2.5-32B-Instruct

# === Voice (InWorld) ===
# Confirm exact URLs + auth method from InWorld docs before use.
# See INWORLD API comments in core/voice/stt/inworld.py and core/voice/tts/inworld.py
INWORLD_API_KEY=
INWORLD_STT_ENDPOINT=wss://
INWORLD_TTS_ENDPOINT=wss://

# Voice variants — paste InWorld voice_id strings from your InWorld console.
# Leave empty to disable a variant. At least one must be set.
# These map to personas: formal=B2B professional, warm=friendly SMB, etc.
INWORLD_VOICE_FORMAL=
INWORLD_VOICE_WARM=
INWORLD_VOICE_ENERGETIC=
INWORLD_VOICE_CALM=
INWORLD_VOICE_CASUAL=
INWORLD_VOICE_TEST=    # set to any voice_id to enable local testing without all 5

# === Telephony (FreePBX — SEPARATE SERVER, not in Coolify) ===
FREEPBX_HOST=192.168.x.x
FREEPBX_ARI_USER=coldcallai
FREEPBX_ARI_SECRET=

# === Database ===
POSTGRES_URL=postgresql+asyncpg://coldcallai:password@pgbouncer:5432/coldcallai
POSTGRES_USER=coldcallai
POSTGRES_PASSWORD=
QDRANT_URL=http://qdrant:6333

# === Worker Queue ===
REDIS_URL=redis://redis:6379/0

# === Recording Storage (MinIO / S3) ===
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
RECORDINGS_BUCKET=coldcallai-recordings

# === CRM ===
ACTIVECAMPAIGN_API_KEY=
ACTIVECAMPAIGN_API_URL=https://youraccountname.api-us1.com

# === Compliance ===
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# === Cost Caps ===
COST_CAP_DAILY_USD=100
COST_CAP_MONTHLY_USD=2000
ALERT_EMAIL=fahadfahim13@gmail.com
